# ==========================================
# GameSwap Phase 1 (MVP) — Environment Config
# ==========================================

# --- Database (PostgreSQL 16 + PostGIS) ---
POSTGRES_DB=gameswap
POSTGRES_USER=gameswap
POSTGRES_PASSWORD=gameswap_dev_pass
POSTGRES_PORT=5432

# --- Cache & Pub/Sub (Redis 7) ---
REDIS_PORT=6379

# --- Backend (Spring Boot 3 / Java 21) ---
SPRING_PROFILES_ACTIVE=dev
BACKEND_PORT=8080
JWT_SECRET=gameswap-super-secret-jwt-key-minimum-256-bits-bangalore-2026
JWT_ACCESS_EXPIRATION_SECONDS=900
JWT_REFRESH_EXPIRATION_SECONDS=2592000
PHONE_HASH_SECRET=gameswap-phone-hmac-secret-bangalore-2026
PHONE_ENCRYPTION_SECRET=gameswap-32byte-aes-secret-key!!

# OTP Provider: "mock" logs OTP to backend console (plug in "msg91" or "twilio" later)
OTP_PROVIDER=mock

# IGDB API (Optional in dev — falls back to seeded local catalogue when blank)
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Matching & Safety Defaults
MATCH_DEFAULT_RADIUS_KM=5.0
MATCH_MAX_RADIUS_KM=25.0
MAX_ACTIVE_WANTS_PER_USER=10
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Frontend (Next.js App Router PWA) ---
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws
